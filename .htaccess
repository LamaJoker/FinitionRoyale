# ════════════════════════════════════════════════════════════
# FINITION ROYALE — .htaccess
# Performance · Sécurité · SEO · Compatible OVH mutualisé
# ════════════════════════════════════════════════════════════

# ─── MIME types explicites (fix CSS OVH) ─────────────────
# Sur certains hébergements mutualisés OVH, les .css sont servis
# en text/plain, ce qui fait qu'ils sont ignorés par le navigateur.
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/svg+xml .svg .svgz
  AddType image/x-icon .ico
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType application/vnd.ms-fontobject .eot
  AddType application/json .json
  AddType application/xml .xml
  AddType text/html .html
</IfModule>

# ─── Charset ─────────────────────────────────────────────
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .xml .json .svg
</IfModule>

# ─── HTTPS forcé ─────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # WWW forcé (décommenter si souhaité)
  # RewriteCond %{HTTP_HOST} ^finitionroyale\.fr$ [NC]
  # RewriteRule ^(.*)$ https://www.finitionroyale.fr%{REQUEST_URI} [L,R=301]

  # URLs propres — ne pas toucher aux fichiers existants
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [NC,L]

  # Redirect .html → sans extension (sauf si fichier a une extension)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# ─── Pages d'erreur ──────────────────────────────────────
ErrorDocument 404 /404.html

# ─── Compression GZIP ────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf application/x-font-ttf application/x-font-otf
</IfModule>

# ─── Cache navigateur ────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  <FilesMatch "\.(woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Sécurité HTTP
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ─── Protection fichiers sensibles ───────────────────────
<FilesMatch "^\.(htaccess|htpasswd|env|git)">
  Require all denied
</FilesMatch>

<Files "rdv-log.txt">
  Require all denied
</Files>
<Files "ip-log.txt">
  Require all denied
</Files>

# ─── Désactiver listing directory ────────────────────────
Options -Indexes

# ─── Timezone PHP ────────────────────────────────────────
<IfModule mod_php7.c>
  php_value date.timezone "Europe/Paris"
</IfModule>
<IfModule mod_php.c>
  php_value date.timezone "Europe/Paris"
</IfModule>
