# .env.deploy — Variables de déploiement FTP OVH
# ⚠️  NE PAS committer ce fichier (ajouté dans .gitignore)
# Usage: source .env.deploy && ./scripts/deploy-ftp.sh

export FTP_HOST="ftp.finitionroyale.fr"
export FTP_USER="votre-login-ftp@finitionroyale.fr"
export FTP_PASS="votre-mot-de-passe-ftp"
export FTP_REMOTE_DIR="/www"
export LOCAL_DIR="./dist"
